nextflow.enable.dsl = 2
workDir = 'work/custom'
process {
    executor = 'local'
    cpus = 2
    memory = '8 GB'
    time = '4h'
}
params {
    samplesheet = null
    reference = null
    truth_vcf = null
    truth_bed = null
    outdir = 'benchmark-runs/custom'
    genome = null
    sample = 'HG002'
}
